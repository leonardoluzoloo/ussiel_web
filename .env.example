# ===================================================================
# NOVATECH ANGOLA - VARIÁVEIS DE AMBIENTE (.env)
# ===================================================================

# 1. BANCO DE DADOS (SUPABASE POSTGRESQL / SQLITE LOCAL)
# Para usar com o Supabase, descomente e substitua pela sua connection string:
# Exemplo Supabase (modo Pooler / Transaction):
# DATABASE_URL=postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Exemplo Conexão Direta Supabase:
# DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJECT-REF].supabase.co:5432/postgres
# Fallback local (SQLite):
DATABASE_URL=sqlite:///./novatech.db

# 2. SEGURANÇA & JWT
SECRET_KEY=novatech_angola_ultra_secure_jwt_token_key_2026_super_secret!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. CONTA ADMINISTRADOR INICIAL
ADMIN_EMAIL=admin@novatech.com
ADMIN_PASSWORD=123456
ADMIN_NAME=Administrador NovaTech
ADMIN_PHONE=+244 923 179 192

# 4. CONFIGURAÇÃO DE SERVIDORES
PORT=8000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
